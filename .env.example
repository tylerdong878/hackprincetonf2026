# Copy this file to .env and fill in your own keys. Never commit .env.

# OpenRouter (free models). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional backup model: Gemini free tier from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: LangSmith tracing (free account at https://smith.langchain.com). Lets you watch every
# Deep Agents step (sub-agents, tool calls, model calls) in a web dashboard. Great for the LangChain demo.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grain-of-salt

# Optional: a free EIA key (https://www.eia.gov/opendata/register.php). DEMO_KEY works but is rate-limited.
EIA_API_KEY=DEMO_KEY
