# Copy this file to .env and fill in your own values. Never commit .env.
# The Daily Grain and Case Files play from the saved case bank and need none of these.

# --- AI models -------------------------------------------------------------------------------
# OpenRouter (free NVIDIA Nemotron models): the puzzle pipeline and Con the Con's live judge.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional backup model, and the iMessage bot's chat partner: Gemini free tier from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: LangSmith tracing (free account at https://smith.langchain.com). Shows every Deep Agents
# step (sub-agents, tool calls, model calls) and every live Con verdict in a web dashboard.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grain-of-salt

# Optional: a free EIA key (https://www.eia.gov/opendata/register.php). DEMO_KEY works but is rate-limited.
EIA_API_KEY=DEMO_KEY

# --- Public mode (for a shared link) ---------------------------------------------------------
# GOS_PUBLIC=1 hides the API docs, rate-limits answers and puts the Editor's Desk behind EDITOR_TOKEN.
GOS_PUBLIC=
# Any long random string; editors type it once when the Editor's Desk asks.
EDITOR_TOKEN=
# Any long random string; open the site with ?demo=<token> on the demo laptop to skip the live-Con caps.
DEMO_TOKEN=
# Live (uncached) Con the Con rounds per day for everyone together, and per player.
CON_LIVE_DAILY_CAP=30
CON_LIVE_PER_PLAYER=3

# --- iMessage bot (uv run python -m backend.imessage) ---------------------------------------
# A Photon 2.0 project key (project:read + project:write) and its project id.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# The game server the bot plays through (use the public link if the bot runs on another machine).
GOS_API_URL=http://127.0.0.1:8000
