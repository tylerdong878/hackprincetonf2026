  "p4": {
    "source": {
      "outlet": "New Jersey Monitor",
      "date": "2026-09-24",
      "url": "https://newjerseymonitor.com/2026/09/24/utilities-board-votes-electric-rates/",
      "before": "Some customers will see individual components of their bills increase, but those will be offset by drops to other components.",
      "highlight": "Atlantic City Electric's average monthly bills, for example, will rise by $4.09 because of changes to its Regional Greenhouse Gas Initiative charges, certain infrastructure investments, and shifts in transmission charges set federally. But those same bills will fall by $4.14 due to changes to some Societal Benefits Charge components and lost sales related to energy efficiency and conservation programs, leaving the average monthly bill 5 cents cheaper than before.",
      "after": ""
    },
